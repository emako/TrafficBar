#include <winres.h>

// PE icon: the original blue icon, readable on dark and light backgrounds
1 ICON "icons/app.ico"

// Runtime icon: notify icon for dark taskbars / light taskbars
101 ICON "icons/notify_dark.ico"
102 ICON "icons/notify_light.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,2,0
 PRODUCTVERSION 1,0,2,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "TrafficBar"
            VALUE "FileVersion", "1.0.2.0"
            VALUE "InternalName", "TrafficBar.exe"
            VALUE "OriginalFilename", "TrafficBar.exe"
            VALUE "ProductName", "TrafficBar"
            VALUE "ProductVersion", "1.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
